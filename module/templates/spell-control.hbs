<div class="t20-wizard-spell-control tw-{{status}}">
    <div class="tw-header">{{localize "T20WIZARD.PanelTitle"}}</div>

    <div class="tw-highlight">
        <div class="tw-highlight-label">{{localize "T20WIZARD.Prepared"}}</div>
        <div class="tw-highlight-value">{{totalPrepared}} / {{limit}}</div>
        <div class="tw-meter">
            <div class="tw-meter-fill" style="width: {{percentUsed}}%"></div>
        </div>
        <div class="tw-highlight-note">
            {{#if isWithinLimit}}
                {{localize "T20WIZARD.Remaining" remaining=remaining}}
            {{else}}
                {{localize "T20WIZARD.ExceededBy" excess=excess}}
            {{/if}}
        </div>
    </div>

    {{#if totalKnown}}
    <table class="tw-circle-table">
        <thead>
            <tr>
                <th class="tw-col-name">{{localize "T20WIZARD.Circle"}}</th>
                <th class="tw-col-num">{{localize "T20WIZARD.Known"}}</th>
                <th class="tw-col-num">{{localize "T20WIZARD.Prepared"}}</th>
            </tr>
        </thead>
        <tbody>
            {{#each circles}}
            {{#if this.known}}
            <tr>
                <td class="tw-col-name">{{localize this.label}}</td>
                <td class="tw-col-num">{{this.known}}</td>
                <td class="tw-col-num">{{this.prepared}}</td>
            </tr>
            {{/if}}
            {{/each}}
        </tbody>
        <tfoot>
            <tr class="tw-total-row">
                <td class="tw-col-name">{{localize "T20WIZARD.Total"}}</td>
                <td class="tw-col-num">{{totalKnown}}</td>
                <td class="tw-col-num">{{totalPrepared}}</td>
            </tr>
        </tfoot>
    </table>

    <div class="tw-type-summary">
        <span class="tw-type tw-type-arcane">{{localize "T20WIZARD.Arcane"}} {{arcane}}</span>
        <span class="tw-type tw-type-divine">{{localize "T20WIZARD.Divine"}} {{divine}}</span>
        <span class="tw-type tw-type-universal">{{localize "T20WIZARD.Universal"}} {{universal}}</span>
    </div>
    {{else}}
    <div class="tw-empty">{{localize "T20WIZARD.NoSpells"}}</div>
    {{/if}}
</div>
